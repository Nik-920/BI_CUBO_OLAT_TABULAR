        "measures": [
          {
            "name": "Total Sales",
            "expression": [
              "",
              "SUM(fact_sales[sale_price])"
            ],
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"3082\" DisplayName=\"€ Español (España)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Gross Margin",
            "expression": [
              "",
              "SUM(fact_sales[gross_margin])"
            ],
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"3082\" DisplayName=\"€ Español (España)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Orders",
            "expression": [
              "",
              "DISTINCTCOUNT(fact_sales[order_id])"
            ],
            "formatString": "0",
            "kpi": {
              "targetExpression": "120000",
              "targetFormatString": "0",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='fact_sales'[Total Orders] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<90000,-1,",
                "\t                If(x<120000,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "StaticValue"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Absolute"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "90000"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "120000"
                }
              ]
            }
          },
          {
            "name": "Margin %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Gross Margin],",
              "    [Total Sales],",
              "    0",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "kpi": {
              "targetExpression": "50",
              "targetFormatString": "0.00 %;-0.00 %;0.00 %",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='fact_sales'[Margin %] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<35,-1,",
                "\t                If(x<50,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "StaticValue"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Absolute"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "35"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "50"
                }
              ]
            }
          },
          {
            "name": "Total Quantity",
            "expression": [
              "",
              "SUM(fact_sales[quantity])"
            ],
            "formatString": "0"
          },
          {
            "name": "Total Sales YTD",
            "expression": [
              "",
              "TOTALYTD(",
              "    [Total Sales],",
              "    dim_date[full_date]",
              ")"
            ],
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "kpi": {
              "targetExpression": "10000000",
              "targetFormatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='fact_sales'[Total Sales YTD] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<7000000,-1,",
                "\t                If(x<10000000,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "StaticValue"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Absolute"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "7000000"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "10000000"
                }
              ]
            },
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"3082\" DisplayName=\"€ Español (España)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Total Sales LY",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Sales],",
              "    SAMEPERIODLASTYEAR(dim_date[full_date])",
              ")"
            ],
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"3082\" DisplayName=\"€ Español (España)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          },
          {
            "name": "Sales YOY Growth %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Total Sales] - [Total Sales LY],",
              "    [Total Sales LY],",
              "    0",
              ")"
            ],
            "formatString": "0.00 %;-0.00 %;0.00 %",
            "kpi": {
              "targetExpression": "150",
              "targetFormatString": "0.00 %;-0.00 %;0.00 %",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='fact_sales'[Sales YOY Growth %] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<100,-1,",
                "\t                If(x<150,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "StaticValue"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Absolute"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "100"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "150"
                }
              ]
            }
          },
          {
            "name": "Total Sales Rolling 3 Months",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Sales],",
              "    DATESINPERIOD(",
              "        dim_date[full_date],",
              "        MAX(dim_date[full_date]),",
              "        -3,",
              "        MONTH",
              "    )",
              ")"
            ],
            "formatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
            "kpi": {
              "targetExpression": "2000000",
              "targetFormatString": "#,0.00 \"€\";-#,0.00 \"€\";#,0.00 \"€\"",
              "statusGraphic": "Traffic Light - Single",
              "statusExpression": [
                "var x='fact_sales'[Total Sales Rolling 3 Months] return",
                "            if(ISBLANK(x),BLANK(),",
                "                    If(x<1500000,-1,",
                "\t                If(x<2000000,0,1)",
                "                )",
                "            )",
                "            "
              ],
              "annotations": [
                {
                  "name": "GoalType",
                  "value": "StaticValue"
                },
                {
                  "name": "KpiStatusType",
                  "value": "Linear"
                },
                {
                  "name": "KpiThresholdType",
                  "value": "Absolute"
                },
                {
                  "name": "KpiThresholdOrdering",
                  "value": "Ascending"
                },
                {
                  "name": "KpiThresholdCount",
                  "value": "2"
                },
                {
                  "name": "KpiThreshold_0",
                  "value": "1500000"
                },
                {
                  "name": "KpiThreshold_1",
                  "value": "2000000"
                }
              ]
            },
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"3082\" DisplayName=\"€ Español (España)\" Symbol=\"€\" PositivePattern=\"3\" NegativePattern=\"8\" /></Format>"
              }
            ]
          }
        ]
